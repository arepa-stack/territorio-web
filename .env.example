# API Configuration
VITE_API_URL=http://127.0.0.1:3000/api

# App Configuration
VITE_APP_NAME=Basketball Tournament System
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Sistema de Gestión de Torneos de Baloncesto

# Environment
VITE_NODE_ENV=development

# Features Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Map Configuration (for zone maps)
VITE_DEFAULT_MAP_CENTER_LAT=4.6097
VITE_DEFAULT_MAP_CENTER_LNG=-74.0817
VITE_DEFAULT_MAP_ZOOM=10

# File Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Chart Configuration
VITE_DEFAULT_CHART_THEME=dark
VITE_CHART_ANIMATION_DURATION=1000

# Localization
VITE_DEFAULT_LOCALE=es
VITE_AVAILABLE_LOCALES=es,en

# Security
VITE_SESSION_TIMEOUT=3600
VITE_ENABLE_CSRF_PROTECTION=true

# Development
VITE_ENABLE_DEVTOOLS=true
VITE_HOT_RELOAD=true